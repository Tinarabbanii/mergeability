# --- NEVER COMMIT THESE ---------------------------------------------------

# model weights: ~430 MB each, 3.4 GB total. GitHub rejects files over 100 MB.
checkpoints/

# downloaded datasets
data/

# generated results. The two reported runs are kept so the numbers can be read
# without a full regeneration; everything else (synthetic harness output, older
# snapshots) stays out. Note git will not descend into an excluded directory, so
# these must be listed as artifacts/* plus explicit re-inclusions.
artifacts/*
!artifacts/clip/
!artifacts/clip16/

# environments
.venv/
__pycache__/
*.py[cod]

# editor / OS noise
.idea/
.vscode/
.DS_Store
.ipynb_checkpoints/

# notebooks are for exploring, not for shipping. Anything that produces a
# result belongs in a .py file that runs top to bottom.
*.ipynb


# --- DO COMMIT ------------------------------------------------------------
# src/  scripts/  configs/  pyproject.toml  uv.lock  README.md
#
# figures/ are small PNGs and worth having visible on GitHub, but only the
# CLIP ones are results. Synthetic figures are test-harness output and must
# never sit in the repo looking like findings.
#
# NOTE: this excludes the CONTENTS (figures/*), not the directory (figures/).
# Git refuses to descend into an excluded directory, so `figures/` followed by
# `!figures/clip/` would silently ignore everything.
figures/*
!figures/clip/
!figures/clip16/

# editor / R noise
.Rhistory
README.html
